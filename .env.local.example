# Supabase 프로젝트(TaronPark's MVP, ref: tmawuxjllizzixancfyg) 설정에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://tmawuxjllizzixancfyg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_public_key_붙여넣기
# service_role 키 (Project Settings > API > service_role secret). 절대 NEXT_PUBLIC_ 접두어를
# 붙이지 말 것 — 브라우저로 노출되면 RLS가 통째로 무력화됨. 3주차 AI 태깅 파이프라인
# (lib/supabase/admin.ts)에서만 사용
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key_붙여넣기

# 카카오 개발자 콘솔(developers.kakao.com)에서 앱 등록 후 발급되는 REST API 키
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키_붙여넣기
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 3주차 AI 태깅 파이프라인용 (아직 안 써도 됨)
ANTHROPIC_API_KEY=여기에_Claude_API_키_붙여넣기

# 4주차 백그라운드 재시도 큐(app/api/cron/retry) 인증용. Vercel Cron이 호출할 때
# Authorization: Bearer $CRON_SECRET 헤더를 자동으로 붙여주는데, 이 값과 일치해야만
# 라우트가 동작함(아무나 URL을 알아도 함부로 호출 못 하게 막는 용도) — 아무 랜덤 문자열이면 됨
CRON_SECRET=여기에_임의의_랜덤_문자열_붙여넣기

# 5주차 시드 콘텐츠 드립 크론(app/api/cron/drip)의 테이퍼링 기준일 (KST, 'YYYY-MM-DD').
# 이 날짜를 1일차로 계산해 1~7일차=하루 30개, 8~14일차=10개, 15일차~=2개로 발행량이 자동
# 축소됨. 값이 없거나 아직 이 날짜 이전이면 코드 기본값(2026-08-01)이 쓰이고 1일차로 clamp됨.
LAUNCH_DATE=2026-08-01
